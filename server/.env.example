NODE_ENV=development
# Gemini (default)
GEMINI_API_KEY=jouw-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible alternatief: OpenAI, Azure-compatible gateway, Ollama of andere provider
# AI_PROVIDER=openai-compatible
# AI_API_KEY=jouw-api-key
# AI_MODEL=jouw-modelnaam
# AI_BASE_URL=https://api.openai.com/v1

# Alleen optie als je één provider zonder Gemini-variabelen wilt:
# AI_PROVIDER=gemini
PORT=8787
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
